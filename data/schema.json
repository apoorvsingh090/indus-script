{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Indus inscription record (Phase 1 / L0)",
  "type": "object",
  "required": ["id", "signs", "sign_scheme", "source_refs"],
  "properties": {
    "id": {"type": "string", "description": "Stable inscription ID, e.g. ICIT-000123"},
    "signs": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Ordered sign codes in reading order; direction recorded separately"
    },
    "sign_scheme": {"type": "string", "enum": ["ICIT", "M77", "P82"]},
    "site": {"type": ["string", "null"]},
    "object_type": {"type": ["string", "null"], "description": "seal, tablet, etc."},
    "side": {"type": ["string", "null"]},
    "completeness": {"type": ["string", "null"], "description": "complete / fragment / uncertain"},
    "direction": {"type": ["string", "null"], "description": "e.g. R2L, L2R, unknown"},
    "source_refs": {
      "type": "array",
      "items": {"type": "string"},
      "description": "e.g. ['M-123', 'CISI 1:45', 'ICIT id 456']"
    },
    "notes": {"type": ["string", "null"]}
  }
}
